# Скопіюйте цей файл у .env (локально) або додайте у Vercel Dashboard →
# Project Settings → Environment Variables.

# =======================
# Supabase Postgres
# =======================
# Створіть проект у https://supabase.com → Settings → Database → Connection string.
#
# DATABASE_URL: pooled connection (pgBouncer, port 6543) — для runtime у serverless.
# DIRECT_URL:   direct connection (port 5432) — використовує Prisma для міграцій.
#
# Обидві починаються так:  postgresql://postgres:<password>@<host>...
DATABASE_URL="postgresql://postgres.xxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# =======================
# Vizard.ai
# =======================
# https://vizard.ai → Settings → API.
# Якщо порожній — UI показує mock-кліпи.
VIZARD_API_KEY=

# =======================
# Google OAuth 2.0 (YouTube Data API) — env-fallback
# =======================
# Основний шлях — BYO Client: кожен проект у БД має свої Client ID +
# Secret (вводяться через UI на сторінці проекту). Цей env-fallback
# використовується лише коли у проекті не задано власних креденшалів —
# зручно для локальної розробки чи спільного демо.
#
# https://console.cloud.google.com → APIs & Services → Credentials →
# Create OAuth client ID → Web application.
# Authorized redirect URIs:
#   local:    http://localhost:3000/api/youtube/callback
#   Vercel:   https://<your-domain>.vercel.app/api/youtube/callback
# Enable: YouTube Data API v3 у Library.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Опційно. Якщо задане, використовується замість автогенерованого callback.
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/youtube/callback

# Опційно: true → проекти без власних DB-креденшалів та без env-fallback
# йдуть у демо-режим (симуляція upload без справжніх викликів API).
# DEMO_YOUTUBE_CONNECT=false

# =======================
# Vercel Cron
# =======================
# Захищає /api/cron/process-uploads. Згенеруйте довгий рандомний рядок
# (`openssl rand -hex 32`) і вставте сюди + у Vercel env. Vercel Cron
# автоматично надсилає "Authorization: Bearer <CRON_SECRET>".
# Якщо порожній — endpoint доступний публічно (для локального тесту).
CRON_SECRET=
