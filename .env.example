# Скопіюйте цей файл у .env та заповніть реальними значеннями.
# Значення також потрібно додати як n8n Credentials у UI — workflow їх
# підтягує через credential references, а не з process.env.

# =======================
# Vizard.ai
# =======================
# API-ключ: https://vizard.ai → Settings → API
# Використовується у n8n як "Header Auth" credential:
#   Name:  Authorization
#   Value: {{ $env.VIZARDAI_API_KEY }}  (або вставити значення напряму)
VIZARDAI_API_KEY=

# =======================
# YouTube Data API v3
# =======================
# Створіть OAuth2 клієнт у Google Cloud Console → увімкніть YouTube Data API v3.
# У n8n використовуйте вбудований "YouTube OAuth2" credential — потрібні
# Client ID та Client Secret.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# =======================
# TikTok Content Posting API
# =======================
# Зареєструйте застосунок на https://developers.tiktok.com/
# Потрібні скоупи: video.publish, video.upload
# У n8n → OAuth2 (Generic) credential:
#   Authorization URL:  https://www.tiktok.com/v2/auth/authorize/
#   Access Token URL:   https://open.tiktokapis.com/v2/oauth/token/
#   Scope:              video.publish,video.upload
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# =======================
# Instagram Graph API (Reels upload)
# =======================
# Потрібен бізнес- або creator-акаунт, прив'язаний до Facebook сторінки.
# https://developers.facebook.com/ → Facebook Login → "Instagram Graph API".
# Скоупи: instagram_basic, instagram_content_publish, pages_read_engagement.
# У n8n → OAuth2 (Generic) з Facebook endpoints.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# =======================
# Загальні налаштування
# =======================
# Webhook-шлях workflow (за замовчуванням "clip-video").
WEBHOOK_PATH=clip-video

# Типова кількість кліпів за один запит (перевизначається body.maxClips).
DEFAULT_MAX_CLIPS=3

# Мінімальний виральний скоринг Vizard (0–100).
DEFAULT_MIN_VIRAL_SCORE=80
