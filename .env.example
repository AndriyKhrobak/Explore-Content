# Скопіюйте цей файл у .env.local (для Next.js) та/або додайте у Vercel
# Dashboard → Project Settings → Environment Variables.

# =======================
# Vizard.ai
# =======================
# https://vizard.ai → Settings → API.
# Якщо порожній — UI показує mock-кліпи.
VIZARD_API_KEY=

# =======================
# Google OAuth 2.0 (YouTube Data API)
# =======================
# https://console.cloud.google.com → APIs & Services → Credentials →
# Create OAuth client ID → Web application.
# Authorized redirect URIs:
#   local:    http://localhost:3000/api/youtube/callback
#   Vercel:   https://<your-domain>.vercel.app/api/youtube/callback
#
# Enable: YouTube Data API v3 в APIs & Services → Library.
#
# Якщо порожні — кнопка "Підключити YouTube" працює у демо-режимі
# (просто ставить флажок connected, без справжнього API).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Опційно. Якщо задане, використовується замість автогенерованого callback.
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/youtube/callback

# Опційно: true → форсувати демо-підключення навіть якщо OAuth налаштований.
# DEMO_YOUTUBE_CONNECT=false

# =======================
# (майбутнє) n8n workflow + TikTok + Instagram
# =======================
# Окремий n8n-workflow у workflows/clip-video-to-shorts.json.
# Відповідні credentials додаються у самому n8n UI, не тут.
